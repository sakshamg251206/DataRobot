# Copy to .env for local development (read automatically on start-up), or set
# these as real environment variables in your shell or hosting provider.
# Every variable is optional: the app runs fully without any of them.

# Server-side Gemini API key. If set, every visitor gets AI features without
# entering their own key, and usage is billed to this key. Leave empty on public
# deployments so each user brings their own key (entered in the sidebar).
GOOGLE_API_KEY=

# Gemini model used for explanations and chat.
GEMINI_MODEL=gemini-2.5-flash

# Allow the AI assistant to WRITE AND EXECUTE Python against the dataset.
# Requires `pip install -e ".[agent]"`. Never enable on a shared/public server.
ENABLE_CODE_AGENT=false

# Uploaded datasets larger than this many rows are truncated.
AUTODS_MAX_ROWS=1000000

# Seed for train/test splits and models, for reproducible results.
AUTODS_RANDOM_STATE=42
